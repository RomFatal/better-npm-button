{
  "name": "better-npm-button",
  "displayName": "Better Npm Button",
  "description": "Run package.json scripts from the Activity Bar. Supports pinning, section headers, sort order, and multi-package workspaces.",
  "version": "0.2.17",
  "publisher": "romfatal",
  "license": "MIT",
  "preview": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/RomFatal/better-npm-button.git"
  },
  "homepage": "https://github.com/RomFatal/better-npm-button#readme",
  "bugs": {
    "url": "https://github.com/RomFatal/better-npm-button/issues"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "scripts",
    "package.json"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:package.json",
    "onView:runSidebar.scripts",
    "onCommand:runSidebar.refresh",
    "onCommand:runSidebar.rerunLast",
    "onCommand:runSidebar.runScript"
  ],
  "files": [
    "out",
    "media/icon.png",
    "media/run-view-screenshot.png",
    "resources",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension runs scripts from the opened workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "This extension requires access to a local file system and integrated terminal."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "runSidebar.refresh",
        "title": "Run: Refresh Scripts",
        "icon": "$(refresh)"
      },
      {
        "command": "runSidebar.rerunLast",
        "title": "Run: Rerun Last Script",
        "icon": "$(history)"
      },
      {
        "command": "runSidebar.runScript",
        "title": "Run: Execute Script"
      },
      {
        "command": "runSidebar.pinScript",
        "title": "Run: Pin Script",
        "icon": "$(pin)"
      },
      {
        "command": "runSidebar.unpinScript",
        "title": "Run: Unpin Script",
        "icon": "$(pinned)"
      },
      {
        "command": "runSidebar.movePinnedUp",
        "title": "Run: Move Pinned Script Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "runSidebar.movePinnedDown",
        "title": "Run: Move Pinned Script Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "runSidebar.setScriptColor",
        "title": "Run: Set Script Icon Color",
        "icon": "$(symbol-color)"
      },
      {
        "command": "runSidebar.showScriptInfo",
        "title": "Run: Show Script Info",
        "icon": "$(info)"
      },
      {
        "command": "runSidebar.showScriptCommands",
        "title": "Run: Show Script Commands",
        "icon": "$(terminal)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "runSidebar",
          "title": "Run",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "runSidebar": [
        {
          "id": "runSidebar.scripts",
          "name": "Scripts",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "runSidebar.refresh",
          "when": "view == runSidebar.scripts",
          "group": "navigation"
        },
        {
          "command": "runSidebar.rerunLast",
          "when": "view == runSidebar.scripts",
          "group": "navigation"
        },
        {
          "command": "runSidebar.showScriptInfo",
          "when": "view == runSidebar.scripts && config.runSidebar.scriptDescription != 'info'",
          "group": "navigation"
        },
        {
          "command": "runSidebar.showScriptCommands",
          "when": "view == runSidebar.scripts && config.runSidebar.scriptDescription == 'info'",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "runSidebar.setScriptColor",
          "when": "view == runSidebar.scripts && viewItem =~ /^script/",
          "group": "inline@1"
        },
        {
          "command": "runSidebar.pinScript",
          "when": "view == runSidebar.scripts && viewItem == script",
          "group": "inline@2"
        },
        {
          "command": "runSidebar.unpinScript",
          "when": "view == runSidebar.scripts && (viewItem == script.pinned.first || viewItem == script.pinned.middle || viewItem == script.pinned.last || viewItem == script.pinned.only)",
          "group": "inline@2"
        },
        {
          "command": "runSidebar.setScriptColor",
          "when": "view == runSidebar.scripts && viewItem =~ /^script/",
          "group": "color@1"
        },
        {
          "command": "runSidebar.pinScript",
          "when": "view == runSidebar.scripts && viewItem == script",
          "group": "script@1"
        },
        {
          "command": "runSidebar.unpinScript",
          "when": "view == runSidebar.scripts && (viewItem == script.pinned.first || viewItem == script.pinned.middle || viewItem == script.pinned.last || viewItem == script.pinned.only)",
          "group": "script@1"
        },
        {
          "command": "runSidebar.movePinnedUp",
          "when": "view == runSidebar.scripts && (viewItem == script.pinned.middle || viewItem == script.pinned.last)",
          "group": "script@2"
        },
        {
          "command": "runSidebar.movePinnedDown",
          "when": "view == runSidebar.scripts && (viewItem == script.pinned.first || viewItem == script.pinned.middle)",
          "group": "script@3"
        }
      ]
    },
    "configuration": {
      "title": "Run",
      "properties": {
        "runSidebar.scope": {
          "type": "string",
          "enum": [
            "root",
            "all"
          ],
          "default": "root",
          "description": "Choose whether to show scripts only from the first workspace folder root package.json or from every package.json in the workspace."
        },
        "runSidebar.showPlayIcon": {
          "type": "boolean",
          "default": true,
          "description": "Show a theme-aware play icon next to each script."
        },
        "runSidebar.scriptUiMode": {
          "type": "string",
          "enum": [
            "default",
            "button"
          ],
          "default": "default",
          "description": "Choose between the standard script list and a more button-like script row layout."
        },
        "runSidebar.packageManager": {
          "type": "string",
          "enum": [
            "auto",
            "npm",
            "pnpm",
            "yarn",
            "bun"
          ],
          "default": "auto",
          "description": "Choose which package manager to use. Auto detects from lockfiles."
        },
        "runSidebar.terminalMode": {
          "type": "string",
          "enum": [
            "reuse",
            "new"
          ],
          "default": "new",
          "description": "Create a new terminal for every script run so the terminal title can match the script name, or reuse a shared terminal with a static title."
        },
        "runSidebar.focusTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Focus the integrated terminal after starting a script."
        },
        "runSidebar.accentColor": {
          "type": "string",
          "enum": [
            "default",
            "green",
            "blue",
            "red",
            "yellow",
            "cyan",
            "magenta"
          ],
          "enumDescriptions": [
            "Use the theme default (green in button mode, no color in default mode).",
            "Green",
            "Blue",
            "Red",
            "Yellow",
            "Cyan",
            "Magenta"
          ],
          "default": "default",
          "description": "Global icon color for all scripts. Individual per-script colors (set via hover icon) take priority."
        },
        "runSidebar.scriptDescription": {
          "type": "string",
          "enum": [
            "command",
            "info"
          ],
          "enumDescriptions": [
            "Show the script's command (default).",
            "Show the script's info from the \"scripts-info\" block in package.json. Scripts without info show their command."
          ],
          "default": "command",
          "markdownDescription": "What to show beside each script name: its info or its command. Info comes from a `\"scripts-info\"` object in `package.json` that maps script names to text, or to an object with a `description` and extra fields such as `env` that the tooltip shows as their own lines (`ntl.descriptions` also works). Scripts without info always show their command, and hovering a script shows both. The Show Script Info / Show Script Commands button in the Scripts view title bar switches between the two."
        },
        "runSidebar.sortOrder": {
          "type": "string",
          "enum": [
            "original",
            "alphabetical",
            "alphabeticalGrouped"
          ],
          "enumDescriptions": [
            "Show scripts in the order they appear in package.json (default).",
            "Sort all scripts alphabetically by name.",
            "Sort scripts alphabetically within each // comment section, preserving section order."
          ],
          "default": "original",
          "description": "Choose how scripts are ordered in the sidebar. Keys that start with // are treated as section headers."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean": "rm -rf out",
    "package:vsix": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^6.0.3"
  }
}
